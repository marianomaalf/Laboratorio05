<VBox prefHeight="826.0" prefWidth="1104.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lab.flotavehicular.controller.FlotaController">
   <children>
      <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="805.0" prefWidth="1080.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox prefHeight="104.0" prefWidth="1104.0">
               <children>
                  <ImageView fitHeight="104.0" fitWidth="144.0" pickOnBounds="true" preserveRatio="true" HBox.hgrow="ALWAYS">
