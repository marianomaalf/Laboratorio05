                              <TableColumn fx:id="colPlaca" prefWidth="119.0" text="Placa" />
                              <TableColumn fx:id="colMarca" prefWidth="136.0" text="Marca" />
                              <TableColumn fx:id="colTipo" prefWidth="140.0" text="Tipo" />
                              <TableColumn fx:id="colKilometraje" minWidth="0.0" prefWidth="142.0" text="Kilometraje" />
                              <TableColumn fx:id="colEstado" prefWidth="161.0" text="Estado" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox layoutX="11.0" layoutY="633.0" prefHeight="176.0" prefWidth="1067.0" styleClass="tarjeta">
