                        <Image url="@../assets/images/flota.png" />
                     </image>
                     <HBox.margin>
                        <Insets left="20.0" right="10.0" />
                     </HBox.margin>
                  </ImageView>
                  <VBox alignment="TOP_CENTER" prefHeight="104.0" prefWidth="821.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="titulo-principal" text="Gestión de Flota Vehicular">
