                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#editarVehiculo" styleClass="boton-editar" text="Editar" textAlignment="CENTER">
                                 <HBox.margin>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#eliminarVehiculo" styleClass="boton-eliminar" text="Eliminar" textAlignment="CENTER">
