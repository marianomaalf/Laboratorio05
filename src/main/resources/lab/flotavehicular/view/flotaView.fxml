                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </HBox.margin>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#limpiarFormulario" prefHeight="25.0" prefWidth="72.0" styleClass="boton-limpiar" text="Limpiar" textAlignment="CENTER">
